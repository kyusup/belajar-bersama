# Local development placeholders. Copy to `.env` and adjust if needed.
# Never commit real secrets.

POSTGRES_DB=belajar_bersama
POSTGRES_USER=belajar
POSTGRES_PASSWORD=belajar
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL=jdbc:postgresql://localhost:55432/belajar_bersama

API_PORT=8080
API_URL=http://localhost:8080
APPLICATION_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000

# memory (default) | s3
STORAGE_PROVIDER=memory
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=belajar-bersama
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Auth. Leave Google/Apple empty to hide those buttons.
# Enable the local stub only on developer machines and in tests.
AUTH_DEV_LOGIN=false
AUTH_COOKIE_SECURE=false
AUTH_BOOTSTRAP_ADMINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

