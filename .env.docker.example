# Docker Compose stack — copy to `.env` or use: docker compose --env-file .env.docker up -d
# Browser-facing URLs stay on localhost; internal services use Docker DNS names.

POSTGRES_DB=belajar_bersama
POSTGRES_USER=belajar
POSTGRES_PASSWORD=belajar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://postgres:5432/belajar_bersama

API_PORT=8080
API_URL=http://localhost:8080
APPLICATION_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000

STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=belajar-bersama
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

AUTH_DEV_LOGIN=true
AUTH_COOKIE_SECURE=false
AUTH_BOOTSTRAP_ADMINS=GOOGLE:admin-1

# Appium tests (host-run): testing/appium/.env
APPIUM_HOST=localhost
APPIUM_PORT=4725
APPIUM_HOST_PORT=4725
WEB_BASE_URL=http://localhost:3000
# Set true when `docker compose --profile mobile up -d` emulator is running
RUN_MOBILE_TESTS=false
